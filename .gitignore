# Rust build artifacts
/target/
**/*.rs.bk

# wasm-pack build output (wasm/) — regenerated by `npm run build:bundler`;
# wasm-pack also self-writes a `pkg/.gitignore` with `*`, this is belt-and-suspenders.
/wasm/pkg/
/wasm/pkg-node/

# Coverage output (cargo-llvm-cov)
/lcov.info
/*.profraw
/*.profdata

# Editor / IDE
.idea/
*.iml
.vscode/*
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db
.gitnexus

# gitnexus writes agent-tooling files into the repository it indexes. They are
# development-loop private and must never be tracked here.
# See DIG-Network/dig_ecosystem#3177. Prefer `gitnexus analyze --skip-agents-md`.
/AGENTS.md
/CLAUDE.md
/.claude/skills/gitnexus/
/.claude/skills/generated/
/.gitnexus/
